**/__pycache__
**/*.pyc
**/*.pyo

# Environment secrets
.env

# Version control
.git
.gitignore

# Specs and docs (not needed in container)
../specs/
*.md

# IDE
.vscode/
.idea/
**/.env*
**/*.env
**/*.pem
**/*.key
**/pw.json
**/donors.json
**/logs/
**/backups/
**/*.log
**/*.csv
**/*.sql*
**/*.sqlite3
