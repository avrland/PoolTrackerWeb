# === Baza danych PostgreSQL ===
# Wspólne dla serwisów: db, web, scrapper, backup
DB_NAME=pooltracker
DB_USER=pooltracker_user
DB_PASSWORD=ZMIEN_TO_NA_SILNE_HASLO
DB_HOST=db
DB_PORT=5432

# === Django ===
SECRET_KEY=ZMIEN_TO_NA_LOSOWY_KLUCZ_MIN_50_ZNAKOW
DJANGO_DEBUG=False

# === Zewnętrzne API (opcjonalne — używane przez aplikację webową) ===
OPENWEATHER_API_KEY=
GEMINI_API_KEY=

# === Ścieżki i adresy (opcjonalne) ===
DONATION_LIST_PATH=donors.json
GODMODE_EMAIL=admin@yourdomain.com
BUYCOFFEE_URL=https://buycoffee.to/basen.bialystok.pl

# === Backup bazy danych ===
# Harmonogram cron wykonywania backupu (domyślnie: raz w tygodniu)
# Składnia: @weekly | @daily | @hourly | "0 2 * * 0" (cron)
SCHEDULE=@weekly
# Liczba dni przechowywania backupów (stare pliki usuwane automatycznie)
BACKUP_KEEP_DAYS=30
# Liczba tygodniowych backupów do zachowania
BACKUP_KEEP_WEEKS=4
